        +notificados_ate(data) ConsultaDeCasos
        +do_municipio(municipio) ConsultaDeCasos
        +agrupada_por(coluna) ConsultaDeCasos
        +ordenada_por(ordem) ConsultaDeCasos
        +montar() tuple
    }
    class CasosSqlite {
